# Copier en .env puis adapter
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://www.nawkat.sn
# Chaîne aléatoire de 32+ caractères : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Paiement : simulation (dev) ou paytech (production : Wave, Orange Money, Free Money, cartes)
PAYMENT_PROVIDER=paytech
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=prod

# Valeurs initiales (modifiables ensuite dans l'administration)
REGISTRATION_FEE=15000
COMMISSION_RATE=0.10

DB_FILE=./data/nawkat.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
